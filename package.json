{
  "name": "cascade",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "A deterministic crisis strategy game about reclaiming control of unregulated AI.",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "stress": "node tools/stress.ts",
    "demo": "node tools/demo.ts",
    "strategies": "node tools/compare-strategies.ts",
    "web:build": "node tools/build-web.mjs",
    "web:serve": "node tools/serve-web.mjs",
    "web": "npm run web:build && npm run web:serve",
    "browser:smoke": "node tools/browser-smoke.mjs",
    "stage5:smoke": "node tools/stage5-smoke.mjs",
    "platform:smoke": "node tools/platform-browser-smoke.mjs",
    "package": "npm run web:build && node tools/package-release.mjs",
    "release:verify": "node tools/verify-release.mjs",
    "release:smoke": "node tools/release-smoke.mjs",
    "release": "npm run package && npm run release:verify && npm run release:smoke",
    "check": "npm run typecheck && npm test && npm run stress && npm run web:build"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
